# ========================================
# Docker Environment Configuration
# ========================================
# Copy this file to .env and update values
# cp .env.docker.example .env

# ========================================
# Node Environment
# ========================================
NODE_ENV=production

# ========================================
# LiteLLM Configuration
# ========================================
# URL to LiteLLM proxy service
# For Docker Compose: use service name (http://litellm:4000)
# For external LiteLLM: use full URL (http://your-litellm-host:4000)
LITELLM_PROXY_URL=http://litellm:4000

# LiteLLM Master API Key
# Must match the LITELLM_MASTER_KEY in your LiteLLM configuration
LITELLM_API_KEY=sk-1234

# ========================================
# NextAuth Configuration
# ========================================
# Generate a secure secret with:
# openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-nextauth-key-here

# Full URL where the application is accessible
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ========================================
# Admin Credentials
# ========================================
# Email for admin login
ADMIN_EMAIL=admin@example.com

# Password for admin login
# IMPORTANT: Change this in production!
ADMIN_PASSWORD=password

# ========================================
# Optional: Database Configuration (if using external LiteLLM)
# ========================================
# If LiteLLM is running externally with its own database,
# you don't need to configure these. They're only needed
# if you're running the full stack with docker-compose.

# PostgreSQL Configuration for LiteLLM
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=litellm
# DATABASE_URL=postgresql://litellm:secret@db:5432/litellm

# ========================================
# Optional: LiteLLM Master Key (for docker-compose)
# ========================================
# LITELLM_MASTER_KEY=sk-1234
# LITELLM_SALT_KEY=this-is-a-random-salt
